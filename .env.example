# La clave nunca debe copiarse a index.html, app.js ni al repositorio.
OPENAI_API_KEY=

# Modelos configurables.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_ANALYSIS_MODEL=gpt-5-mini

# Servidor local. 127.0.0.1 evita exponerlo a la red del hogar u oficina.
HOST=127.0.0.1
PORT=4173

# Límites defensivos.
MAX_AUDIO_MB=20
MAX_JSON_KB=768
OPENAI_TIMEOUT_MS=120000
